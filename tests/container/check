#!/bin/sh
set -eu

cd /work
if [ ! -d node_modules ]; then
    cp -R /opt/dependencies/node_modules node_modules
fi
export PATH="/work/node_modules/.bin:${PATH}"

run_task() {
    task=$1
    shift
    case "$task" in
    lint)
        shellcheck -x -P SCRIPTDIR tests/container/run tests/container/check
        npm run lint
        ;;
    test)
        npm run test -- --runInBand "$@"
        ;;
    build)
        npm run build
        npm run size
        npm run package
        ;;
    *)
        printf 'Unknown check task: %s\n' "$task" >&2
        exit 2
        ;;
    esac
}

case "${1:-}" in
check)
    run_task lint
    run_task test
    run_task build
    ;;
lint|test|build)
    task=$1
    shift
    run_task "$task" "$@"
    ;;
exec)
    shift
    if [ "$#" -gt 0 ]; then
        exec "$@"
    fi
    : "${COMMAND:?COMMAND is required}"
    exec sh -ec "$COMMAND"
    ;;
*)
    printf 'Usage: check check|lint|test|build|exec COMMAND [ARG...]\n' >&2
    exit 2
    ;;
esac
